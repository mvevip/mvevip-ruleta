# ==========================================
# MARKETING VIP - CONFIGURACIÓN DE ENTORNO
# ==========================================
NODE_ENV=development

# Rango de puertos asignados (5500 - 5520)
PORT_API=5500
PORT_DB=5501
PORT_SCREEN=5502
PORT_MOBILE=5503
PORT_ADMIN=5504

# URLs de Conexión Frontend & Sockets
VITE_API_URL=http://localhost:5500
VITE_WS_URL=http://localhost:5500
VITE_SCREEN_URL=http://localhost:5502
VITE_MOBILE_URL=http://localhost:5503
VITE_ADMIN_URL=http://localhost:5504

# Configuración Base de Datos MySQL Local (Docker)
DB_HOST=db
DB_PORT=3306
DB_NAME=marketingvip_roulette
DB_USER=vip_user
DB_PASSWORD=vip_secure_password
DB_ROOT_PASSWORD=vip_root_password

# Empresa y Campaña
COMPANY_NAME="Marketing VIP"
COMPANY_SLOGAN="Especialistas en sueños"
COMPANY_BRAND_COLOR="#9AC31C"
WHATSAPP_NUMBER="593999999999"

# Configuración Despliegue AWS CLI (Opcional para deploy_aws.ps1)
AWS_PROFILE=marketingvip
AWS_REGION=us-west-2
